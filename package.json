{
  "name": "snakeboom",
  "private": true,
  "version": "0.9.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,relay -c cyan,magenta \"vite --open\" \"tsx watch src/server/main.ts\"",
    "dev:web": "vite --open",
    "dev:relay": "tsx watch src/server/main.ts",
    "build": "tsc --noEmit && vite build && vite build --config vite.server.config.ts",
    "build:server": "vite build --config vite.server.config.ts",
    "start:server": "node dist-server/index.js",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "soak": "tsx scripts/soak.ts",
    "bench:rollback": "tsx scripts/bench-rollback.ts"
  },
  "dependencies": {
    "@fontsource/orbitron": "5.3.0",
    "@hono/node-server": "2.1.1",
    "hono": "4.13.8",
    "lil-gui": "0.21.0",
    "pixi-filters": "6.1.5",
    "pixi.js": "8.21.0",
    "ws": "8.21.3",
    "zzfx": "1.3.2"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "@types/ws": "8.18.1",
    "concurrently": "10.0.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
